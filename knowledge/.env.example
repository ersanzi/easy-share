# 本地服务与 Local Lab（仅允许回环地址）
HOST=127.0.0.1
PORT=8000
LOCAL_LAB_ENABLED=true

# RustFS（S3 兼容）— 凭证从 deploy/rustfs/.env 取，勿在此写死生产密钥
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=easyshare

# LLM（OpenAI 兼容）— 留空则 /query 只返回检索片段不做生成
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding（OpenAI 兼容）— 留空则退回 HashEmbedder 仅跑通管线，无语义能力
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# Reranker（OpenAI 兼容 rerank API）— 留空则保持原始排序
# 百炼: https://dashscope.aliyuncs.com/compatible-mode/v1 + gte-rerank
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# OCR（可选；需要扫描件/图片时另行安装 requirements-ocr.txt）
OCR_ENABLED=true
OCR_LANG=ch
OCR_MIN_TEXT_CHARS=20

# 切块与检索
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5

# 本地持久化与任务执行（单个 Uvicorn worker）
VECTOR_STORE_PATH=./data/vector_store.json
JOB_STORE_PATH=./data/jobs.db
JOB_WORKERS=2
MAX_SOURCE_BYTES=104857600

# Milvus 向量库（可选；留空则使用 JSON 文件存储）
# 本地 Standalone 部署见 docker-compose.milvus.yml
# 安装依赖：pip install -r requirements-milvus.txt
MILVUS_URI=
MILVUS_COLLECTION=easyshare_chunks

# 账号与登录（薄控制面；默认关闭，公司部署建议开启）
# 开启后 /documents、/query、/ingest、/lab/api/uploads 需 Bearer 令牌
AUTH_ENABLED=false
AUTH_DB_PATH=./data/auth.db
AUTH_TOKEN_EXPIRY_HOURS=168

# 目录监听自动入库（分号分隔可配多个；空=关闭）
# 指向共享盘/钉盘同步夹：新文件与改动文件自动流入知识库（同内容不重复入库）
WATCH_DIRS=
WATCH_INTERVAL_SECONDS=30
WATCH_STABLE_SECONDS=5

# MCP Server（可选；pip install mcp 后 python -m app.mcp_server 独立启动）
KNOWLEDGE_BASE_URL=http://127.0.0.1:8000
