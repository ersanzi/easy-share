# EasyShare 服务器环境变量模板。
# 拷贝到 /opt/easyshare/control-plane/rustfs.env 后填写（deploy.sh 会代生成，可手改）。
# 本文件含对象存储根凭据，绝不入 git；服务器上只放 control-plane/ 下。

# RustFS 根凭据（rustfs 容器与控制面共用；泄露等于整个存储裸奔，用长随机串）
RUSTFS_ACCESS_KEY=easyshare-please-change
RUSTFS_SECRET_KEY=please-change-to-a-long-random-string

# 知识服务与控制面共用的桶
RUSTFS_BUCKET=easyshare

# ⚠ 控制面签发的预签名 URL 会把这个地址原样发给客户端（同事电脑直传），
#   必须填服务器局域网 IP 或内网域名，不能填 127.0.0.1
RUSTFS_ENDPOINT=http://<服务器局域网IP>:9000

# 云盘池上限的容量探测路径：宿主侧真实磁盘路径（RustFS 数据卷所在盘）。
# Linux 单盘机器用 /opt/easyshare 即可；数据盘独立挂载时改成挂载点。
RUSTFS_CAPACITY_PATH=/opt/easyshare
