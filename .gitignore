# ─── 构建产物 ───
build/bin/
build/windows/installer/tmp/
*.exe
!build/windows/*.ico

# ─── Wails ───
.wails/

# ─── Go ───
vendor/
*.test
*.out
coverage.*

# ─── 前端 ───
node_modules/
frontend/dist/
frontend/node_modules/

# ─── 运行时配置与数据 ───
config.json
*.log
*.tmp

# ─── IDE / 编辑器 ───
.idea/
.vscode/
*.swp
*.swo
*~

# ─── 操作系统 ───
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ─── 环境变量 ───
.env
.env.*
!knowledge/.env.example

# ─── 旧脚手架目录 ───
easyshare-scaffold/

# ─── RuoYi 控制面（platform/：独立 Java 工程，自带 .git，不纳入本 Go 仓）───
platform/
# RuoYi admin 在仓库根运行时写 logs/（sys-console/sys-info/sys-error 及 .gz 轮转，*.log 覆盖不了 gz）
logs/
# ─── Python ───
__pycache__/
*.py[cod]

# ─── 本地测试产物 ───
.playwright-cli/
output/playwright/
# 知识面 pytest 从仓库根跑时的 SQLite 落点（auth/jobs/query_log）
data/
# 计划模式会话产物（.zcode/commands 是版本化的，plans 不是）
.zcode/plans/
# platform-drive 的 Maven 构建产物（platform/ 整体已忽略，模块在仓内需单独忽略）
platform-drive/target/
